                        "path": {
                          "type": "string",
                          "minLength": 1
                        },
                        "quote": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    }
                  }
                }
              },
              "typeDifferentiation": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "score",
                  "rationale",
                  "evidence"
                ],
                "properties": {
                  "score": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 5
                  },
                  "rationale": {
                    "type": "string",
                    "minLength": 30
                  },
                  "evidence": {
