      "minItems": 128,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "reportHash",
          "criteria",
          "criticalFlags",
          "findings"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "reportHash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "criteria": {
